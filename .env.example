# Set by the Neon integration on Vercel (Storage tab). For local `vercel dev`, run `vercel env pull`.
DATABASE_URL=
# From your GitHub OAuth app (github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Any random string of 32+ characters, e.g. the output of: openssl rand -base64 48
SESSION_SECRET=
# Optional: your public URL if you use a custom domain, e.g. https://prep.example.com
PUBLIC_URL=
