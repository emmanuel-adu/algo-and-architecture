# Neon Postgres. `neon deploy` or `neon env pull` writes both to .env.local.
# DATABASE_URL is the pooled connection (host ends in -pooler): the app uses it. Add it to Vercel too.
DATABASE_URL=
# Direct connection, used only by `npm run db:migrate`.
DATABASE_URL_UNPOOLED=
# From your GitHub OAuth app (github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Any random string of 32+ characters, e.g. the output of: openssl rand -base64 48
SESSION_SECRET=
# Optional: your public URL if you use a custom domain, e.g. https://prep.example.com
PUBLIC_URL=
